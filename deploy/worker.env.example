SPECGUARD_ENV=production
SPECGUARD_WORKER_TOKEN=REPLACE_WITH_THE_SAME_64_RANDOM_HEX_CHARACTERS
SPECGUARD_DOCKER_RUNTIME=runsc
# Replace with the immutable digest printed after building/pushing the runner.
SPECGUARD_RUNNER_IMAGE=YOUR_REGISTRY/specguard-runner@sha256:REPLACE
TMPDIR=/var/lib/specguard-worker/jobs
