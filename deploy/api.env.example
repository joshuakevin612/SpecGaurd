SPECGUARD_ENV=production
SPECGUARD_RUNNER=docker
SPECGUARD_BACKEND_PROVIDER=nvidia
SPECGUARD_DB=/var/lib/specguard/specguard.db
SPECGUARD_ALLOWED_HOSTS=YOUR_DOMAIN,127.0.0.1
SPECGUARD_CORS_ORIGINS=https://YOUR_DOMAIN
SPECGUARD_WORKER_URL=http://127.0.0.1:8001
SPECGUARD_WORKER_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SPECGUARD_SIGNUP_ENABLED=true
SPECGUARD_MAX_ACCOUNTS=500
SPECGUARD_DAILY_RUNS=20
SPECGUARD_GLOBAL_DAILY_RUNS=100
SPECGUARD_MAX_OUTPUT_TOKENS=4096
SPECGUARD_TIMEOUT_SECONDS=40
SPECGUARD_USAGE_FILE=/var/lib/specguard/usage.jsonl
NVIDIA_API_KEY=REPLACE_WITH_PROVIDER_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_CODE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
