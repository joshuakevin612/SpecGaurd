# NVIDIA for live development; mock demos/tests make no network requests.
# Providers never fall back to one another.
SPECGUARD_PROVIDER=mock
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Structured test planning and repairs; may be configured separately from parsing.
NVIDIA_CODE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Limits are per model call; token totals are recorded in artifacts/usage.jsonl.
SPECGUARD_MAX_OUTPUT_TOKENS=4096
SPECGUARD_TIMEOUT_SECONDS=60
SPECGUARD_USAGE_FILE=artifacts/usage.jsonl
# Integrated platform settings (set before starting uvicorn).
SPECGUARD_BACKEND_PROVIDER=mock
# Docker is the default. Use local only for trusted code on your own machine.
SPECGUARD_RUNNER=docker
SPECGUARD_DB=./specguard.db
SPECGUARD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5175,http://localhost:5175

# Optional legacy operator token for development APIs; never put it in VITE_ config.
# Public production uses account cookies, CSRF checks and the private worker instead.
SPECGUARD_API_TOKEN=
SPECGUARD_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Local development defaults. Public hosting requires HTTPS and a private gVisor worker.
SPECGUARD_ENV=development
SPECGUARD_AUTH_REQUIRED=false
SPECGUARD_SIGNUP_ENABLED=true
SPECGUARD_MAX_ACCOUNTS=500
SPECGUARD_DAILY_RUNS=20
SPECGUARD_GLOBAL_DAILY_RUNS=100
# For isolated worker development; production requires a private worker and runsc.
# SPECGUARD_WORKER_URL=http://127.0.0.1:8001
# SPECGUARD_WORKER_TOKEN=
# SPECGUARD_DOCKER_RUNTIME=runsc
